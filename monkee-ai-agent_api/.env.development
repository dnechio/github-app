# ── App ───────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── MongoDB (docker-compose.infra.yml) ────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=criminal_player_v2

# ── Redis (docker-compose.infra.yml) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS S3 — usando MinIO local (docker-compose.infra.yml) ────────
# Para S3 real: troque pelo endpoint da AWS e suas credenciais
AWS_REGION=us-east-1
AWS_S3_BUCKET=criminal-player-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Endpoint customizado para MinIO — REMOVA para usar S3 real
AWS_ENDPOINT_URL=http://localhost:9000

# ── AI Providers — preencha ao menos UM ──────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=

# ── Qdrant (docker-compose.infra.yml) ─────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8
